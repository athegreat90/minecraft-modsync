MODSYNC_AGENT_IMAGE=minecraft-modsync-agent:local
MODSYNC_STATE_PATH=/absolute/path/to/agent-state
MINECRAFT_SERVERS_PATH=/actual/host/path/to/crafty/servers
MODSYNC_SCAN_INTERVAL=300
# Configure HTTPS URL through setup; state preserves identity across restarts.
MODSYNC_SERVER_URL=https://modsync.example.net
